# NutriChef Backend Environment Variables Example
# Copy to .env or configure in your deployment platform (Render)

# Server port (default 8080)
PORT=8080

# Database Connection (MySQL / Aiven MySQL)
DB_URL=jdbc:mysql://your-aiven-mysql-host.aivencloud.com:12345/nutrichef_db?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=avnadmin
DB_PASSWORD=your_secure_mysql_password

# JWT Security
# Must be a 256-bit secret key (at least 32 characters or 64 hex characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=https://nutrichef-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# Optional: Edamam Nutrition API Credentials (leave empty for demo mode)
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
